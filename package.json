{
  "name": "checkout-onboarding-app",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test",
    "test:cov": "pnpm -r test:cov",
    "lint": "pnpm -r lint",
    "build": "pnpm -r build",
    "build:deploy": "pnpm --filter backend build:lambda && pnpm --filter frontend build",
    "deploy": "pnpm build:deploy && pnpm --filter infra deploy",
    "seed:aws": "DYNAMODB_ENDPOINT= pnpm --filter backend db:setup"
  }
}
